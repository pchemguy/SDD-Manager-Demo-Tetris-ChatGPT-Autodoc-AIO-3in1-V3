{
  "name": "tetris-three-platforms",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run build:schemas && vite --host 127.0.0.1",
    "check": "npm run build:schemas && tsc --noEmit",
    "test:unit": "npm run build:schemas && vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build:schemas && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "probe:browsers": "node scripts/probe-browsers.mjs",
    "package": "npm run build && python scripts/package-browser.py",
    "verify:package": "python scripts/package-browser.py --verify --extract dist/package-smoke",
    "build:schemas": "node scripts/build-schemas.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
