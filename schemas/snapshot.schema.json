{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetris.invalid/schemas/snapshot.schema.json",
  "title": "Tetris portable snapshot version 1",
  "type": "object",
  "required": ["formatVersion", "results", "settings"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"type": "integer", "const": 1},
    "results": {
      "type": "array", "minItems": 0, "maxItems": 10,
      "items": {
        "type": "object", "required": ["id", "score", "timestamp"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"},
          "score": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "timestamp": {"type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])"}
        }
      }
    },
    "settings": {
      "type": "object",
      "required": ["ghost", "hardDrop", "nextPreview", "hardDropLock", "lockPolicy", "hold"],
      "additionalProperties": false,
      "properties": {
        "ghost": {"type": "string", "enum": ["hide", "dynamic", "show"]},
        "hardDrop": {"type": "boolean"},
        "nextPreview": {"type": "boolean"},
        "hardDropLock": {"type": "string", "enum": ["general", "immediate"]},
        "lockPolicy": {"type": "string", "enum": ["failed", "interval"]},
        "hold": {"type": "boolean"}
      }
    }
  },
  "$comment": "Semantic validation additionally requires real Gregorian dates and unique result IDs; import never truncates rows. Format annotations alone are not acceptance."
}
